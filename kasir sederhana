entry_jumlah.pack(fill="x", pady=2)

btn_tambah = tk.Button(frame_input, text="➕ Masukkan ke Keranjang", command=tambah_item, bg="#2563eb", fg="white", font=("Segoe UI", 9, "bold"), bd=0, pady=6, cursor="hand2")
btn_tambah.pack(fill="x", pady=8)

# Frame Tabel Keranjang (Menggunakan ttk.Treeview)
frame_cart = tk.LabelFrame(root, text=" Tabel Keranjang Belanja ", font=("Segoe UI", 10, "bold"), bg="white", fg="#334155", padx=10, pady=5)
frame_cart.pack(fill="both", expand=True, padx=20, pady=5)

columns = ("nama", "harga", "jumlah", "subtotal")
tree = ttk.Treeview(frame_cart, columns=columns, show="headings", height=5)
tree.heading("nama", text="Nama Barang")
tree.heading("harga", text="Harga Satuan")
