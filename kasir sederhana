# List global untuk menyimpan data keranjang belanja
keranjang_belanja = []

# Fungsi untuk memformat angka otomatis dengan titik ribuan (misal: 50000 -> 50.000)
def format_ribuan(event, entry_widget, string_var):
    nilai_asli = string_var.get()
    hanya_angka = "".join(filter(str.isdigit, nilai_asli))
    
    if hanya_angka:
        format_angka = f"{int(hanya_angka):,}".replace(",", ".")
        string_var.set(format_angka)
        entry_widget.icursor(tk.END)
    else:
        string_var.set("")

def bersihkan_angka(teks):
    return float(str(teks).replace(".", ""))

# Fungsi untuk menambah barang ke keranjang & tabel
def tambah_item():
    try:
        nama = entry_nama.get().strip()
        val_harga = var_harga.get()
        val_jumlah = entry_jumlah.get()
        
        if not nama or not val_harga or not val_jumlah:
            messagebox.showwarning("Peringatan", "Nama barang, harga, dan jumlah wajib diisi!")
            return
            
        harga = bersihkan_angka(val_harga)
        jumlah = int(val_jumlah)
        
        if harga <= 0 or jumlah <= 0:
            messagebox.showerror("Error", "Harga dan jumlah harus lebih dari 0!")
            return
            
        subtotal = harga * jumlah
        
        # Masukkan ke list
        keranjang_belanja.append({"nama": nama, "harga": harga, "jumlah": jumlah, "subtotal": subtotal})
        
        # Masukkan ke Tabel (Treeview)
        tree.insert("", tk.END, values=(nama, f"Rp {harga:,.0f}".replace(",", "."), jumlah, f"Rp {subtotal:,.0f}".replace(",", ".")))
        
        update_total_sementara()
        
        # Reset input barang
