import tkinter as tk
from tkinter import messagebox, ttk
import datetime
import os
import sys

# List global untuk menyimpan data keranjang belanja
keranjang_belanja = []

# Fungsi untuk memformat angka otomatis dengan titik ribuan (misal: 50000 -> 50.000)
def format_ribuan(event, entry_widget, string_var):
    nilai_asli = string_var.get()
    hanya_angka = "".join(filter(str.isdigit, nilai_asli))
    
    if hanya_angka:
        format_angka = f"{int(hanya_angka):,}".replace(",", ".")
        string_var.set(format_angka)
        entry_widget.icursor(tk.END)
    else:
        string_var.set("")

def bersihkan_angka(teks):
    return float(str(teks).replace(".", ""))

# Fungsi untuk menambah barang ke keranjang & tabel
def tambah_item():
    try:
        nama = entry_nama.get().strip()
        val_harga = var_harga.get()
        val_jumlah = entry_jumlah.get()
        
        if not nama or not val_harga or not val_jumlah:
            messagebox.showwarning("Peringatan", "Nama barang, harga, dan jumlah wajib diisi!")
            return
            
        harga = bersihkan_angka(val_harga)
        jumlah = int(val_jumlah)
        
        if harga <= 0 or jumlah <= 0:
            messagebox.showerror("Error", "Harga dan jumlah harus lebih dari 0!")
            return
            
        subtotal = harga * jumlah
        
        # Masukkan ke list
        keranjang_belanja.append({"nama": nama, "harga": harga, "jumlah": jumlah, "subtotal": subtotal})
        
        # Masukkan ke Tabel (Treeview)
        tree.insert("", tk.END, values=(nama, f"Rp {harga:,.0f}".replace(",", "."), jumlah, f"Rp {subtotal:,.0f}".replace(",", ".")))
        
        update_total_sementara()
        
        # Reset input barang
        entry_nama.delete(0, tk.END)
        var_harga.set("")
        entry_jumlah.delete(0, tk.END)
        entry_nama.focus()
        
    except ValueError:
        messagebox.showerror("Error", "Format angka jumlah tidak valid!")

# Fungsi untuk menghapus item yang dipilih di tabel
def hapus_item_pilih():
    selected_items = tree.selection()
    if not selected_items:
        messagebox.showwarning("Peringatan", "Pilih dulu salah satu baris di tabel yang mau dihapus!")
        return
        
    for item in selected_items:
        index = tree.index(item)
        tree.delete(item)
        keranjang_belanja.pop(index)
        
    update_total_sementara()

# Fungsi memperbarui total belanja sementara
def update_total_sementara():
    total = sum(item["subtotal"] for item in keranjang_belanja)
    label_total_val.config(text=f"Rp {total:,.0f}".replace(",", "."))

# Fungsi utama proses pembayaran, simpan .txt, dan auto print
def proses_pembayaran():
    if not keranjang_belanja:
        messagebox.showwarning("Kosong", "Keranjang belanja masih kosong!")
        return
        
    val_bayar = var_bayar.get()
    if not val_bayar:
        messagebox.showwarning("Peringatan", "Masukkan uang pembayaran terlebih dahulu!")
        return
        
    total_belanja = sum(item["subtotal"] for item in keranjang_belanja)
    bayar = bersihkan_angka(val_bayar)
    
    # Logika Diskon Bertingkat
    if total_belanja >= 150000:
        diskon = total_belanja * 0.20
        info_diskon = "Diskon VIP 20%"
    elif total_belanja >= 100000:
        diskon = total_belanja * 0.15
        info_diskon = "Diskon Spesial 15%"
    elif total_belanja >= 50000:
        diskon = total_belanja * 0.10
        info_diskon = "Diskon Member 10%"
    else:
        diskon = 0
        info_diskon = "Tanpa Diskon"
        
    total_akhir = total_belanja - diskon
    
    if bayar < total_akhir:
        kurang = total_akhir - bayar
        messagebox.showerror("Uang Kurang", f"Uang pembeli kurang Rp {kurang:,.0f}".replace(",", "."))
        return
        
    kembalian = bayar - total_akhir
    waktu_sekarang = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")

# Format Struk
    struk = "=" * 44 + "\n"
    struk += "          STRUK KASIR TOKO NUSANTARA        \n"
    struk += f"          Waktu: {waktu_sekarang}      \n"
    struk += "=" * 44 + "\n"
    for item in keranjang_belanja:
        struk += f"• {item['nama']} ({item['jumlah']}x @{item['harga']:,.0f})\n  Subtotal: Rp {item['subtotal']:,.0f}\n".replace(",", ".")
    struk += "-" * 44 + "\n"
    struk += f"Total Belanja   : Rp {total_belanja:,.0f}\n".replace(",", ".")
    struk += f"Promo / Diskon  : {info_diskon} (-Rp {diskon:,.0f})\n".replace(",", ".")
    struk += f"TOTAL AKHIR     : Rp {total_akhir:,.0f}\n".replace(",", ".")
    struk += f"Uang Tunai      : Rp {bayar:,.0f}\n".replace(",", ".")
    struk += f"Kembalian       : Rp {kembalian:,.0f}\n".replace(",", ".")
    struk += "=" * 44 + "\n"
    struk += "        TERIMA KASIH TELAH BERBELANJA       \n"
    struk += "=" * 44
    
    # 1. Simpan struk otomatis ke file .txt
    nama_file_txt = f"struk_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
    with open(nama_file_txt, "w", encoding="utf-8") as f:
        f.write(struk)
        
    # 2. Perintah Otomatis Cetak (Print) ke Printer Default Komputer
    status_print = ""
    try:
        if sys.platform == "win32":
            os.startfile(nama_file_txt, "print")
        else:
            os.system(f"lpr {nama_file_txt}")
        status_print = "🖨️ Struk berhasil dikirim ke printer!"
    except Exception:
        status_print = "⚠️ Struk tersimpan, tapi printer tidak terdeteksi/siap."
        
    messagebox.showinfo("Transaksi Berhasil!", f"{struk}\n\n📁 File: {nama_file_txt}\n{status_print}")
    reset_semua()

# Fungsi Reset
def reset_semua():
    global keranjang_belanja
    keranjang_belanja = []
    for item in tree.get_children():
        tree.delete(item)
    entry_nama.delete(0, tk.END)
    var_harga.set("")
    entry_jumlah.delete(0, tk.END)
    var_bayar.set("")
    label_total_val.config(text="Rp 0")

