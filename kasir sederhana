tree.column("nama", width=140, anchor="w")
tree.column("harga", width=90, anchor="center")
tree.column("jumlah", width=40, anchor="center")
tree.column("subtotal", width=100, anchor="center")
tree.pack(fill="both", expand=True, pady=2)

btn_hapus = tk.Button(frame_cart, text="🗑️ Hapus Item Terpilih", command=hapus_item_pilih, bg="#dc2626", fg="white", font=("Segoe UI", 8, "bold"), bd=0, pady=3, cursor="hand2")
btn_hapus.pack(anchor="e", pady=2)

# Total Sementara
frame_total = tk.Frame(root, bg="#f8fafc")
frame_total.pack(fill="x", padx=20, pady=5)
tk.Label(frame_total, text="Total Belanja:", font=("Segoe UI", 11, "bold"), bg="#f8fafc", fg="#334155").pack(side="left")
label_total_val = tk.Label(frame_total, text="Rp 0", font=("Segoe UI", 12, "bold"), bg="#f8fafc", fg="#059669")
label_total_val.pack(side="right")

# Frame Pembayaran
frame_bayar = tk.LabelFrame(root, text=" Pembayaran ", font=("Segoe UI", 10, "bold"), bg="white", fg="#334155", padx=15, pady=8)
frame_bayar.pack(fill="x", padx=20, pady=5)

# Frame Pembayaran
frame_bayar = tk.LabelFrame(root, text=" Pembayaran ", font=("Segoe UI", 10, "bold"), bg="white", fg="#334155", padx=15, pady=8)
frame_bayar.pack(fill="x", padx=20, pady=5)

tk.Label(frame_bayar, text="Uang Tunai Pembeli (Rp):", bg="white", font=("Segoe UI", 9)).pack(anchor="w")
